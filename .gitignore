shortcuts/*.shortcut
# Built by the installer from tools/ocr.swift.
/tools/ocr
# The working roadmap and the old quick tunnel stay private; ROADMAP.md is the public roadmap.
/PROJECT.md
/tools/tunnel.sh
/server/com.recall.tunnel.plist
# The river painting (artist not known): kept out of the public repo; installs without it show the delta.
/app/static/river-*
