# Each person's private library lives here; never shared through this repo.
.DS_Store
imports/
inbox/
libraries/
library/
node_modules/
tools/node_modules/
tools/.venv/
.thumbs/
.trash/
shortcuts/*.unsigned.shortcut
.local/
.board-cache/
dist/

# This install's settings and secrets; .env.example is the template.
.env
.env.*
!.env.example
# GBrain's owner lock for this checkout (holds a token).
.gbrain-owner-*.json
# Private working notes: ops logs, morning lists, review screenshots of real data.
private/
docs/private/
backups/
# Private working notes kept in place (ops logs, morning lists, live-page sources, reviews and screenshots of real data).
/docs/ops-log.md
/docs/morning.md
/docs/HANDOFF.md
/docs/sonnet-ops-prompt.md
