# Recall settings. Copy to .env (the installer does this), fill in, then: cl app restart
# Real environment variables win over this file.

# The address people open Recall at. Locally: http://localhost:3344
RECALL_PUBLIC_URL=http://localhost:3344
# The Google account that owns this install. Its library is the main one, and only it can invite and add keys.
RECALL_OWNER_EMAIL=you@example.com
# The owner's first name, as people see it ("Ask Sam for a new link").
RECALL_OWNER_NAME=Sam
# Who runs this install, for the privacy page.
RECALL_OPERATOR=Sam Example
# Where people write to have their library deleted.
RECALL_CONTACT_EMAIL=you@example.com
# Sender for invite emails, if you add a Resend key (optional).
RECALL_INVITE_FROM=Recall <invites@example.com>
# This Mac's Tailscale https name, for phones on your private network (optional).
CL_HTTPS_HOST=
# The local models (optional): LIBRARIAN_MODEL=gemma3:4b, WHISPER_MODEL=mlx-community/whisper-base.en-mlx
# One sentence about the owner, for the library's sorting model (optional).
RECALL_OWNER_ABOUT=
# Your team's first board: its name, and the id it's stored under (optional).
RECALL_TEAM_NAME=Team
RECALL_TEAM_ID=team
